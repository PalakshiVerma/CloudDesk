# ==============================================================================
# CloudDesk — Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=CloudDesk
API_V1_STR=/api/v1

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Relational Database (Local Docker or Neon Cloud)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://clouddesk_user:clouddesk_secure_password@localhost:5432/clouddesk_db

# Qdrant Vector Database (Local Docker or Qdrant Cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI LLM & Embedding Settings
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Triage & Routing Thresholds
CONFIDENCE_THRESHOLD=0.85
MAX_TRIAGE_RETRY_ATTEMPTS=1
LLM_TIMEOUT_SECONDS=8.0

# Mock External Helpdesk Webhook URLs
MOCK_HELPDESK_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/mock-helpdesk/status-update

# Frontend Configuration
BACKEND_API_URL=http://localhost:8000/api/v1
